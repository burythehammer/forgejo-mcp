{
  "mcpServers": {
    "burythehammer": {
      "type": "stdio",
      "command": "${FORGEJO_MCP_EXEC:-forgejo-mcp}",
      "args": [
        "-transport",
        "stdio",
        "-token",
        "${BURYTHEHAMMER_FORGEJO_TOKEN}",
        "-url",
        "https://forgejo.burythehammer.com"
      ],
      "env": {}
    }
  }
}
