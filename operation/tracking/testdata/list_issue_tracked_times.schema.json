{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List tracked time entries on an issue or pull request",
  "inputSchema": {
    "properties": {
      "before": {
        "description": "Before time (RFC3339)",
        "type": "string"
      },
      "index": {
        "description": "Issue or pull request index (Forgejo shares index namespace between the two)",
        "type": "number"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "since": {
        "description": "After time (RFC3339)",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "index"
    ],
    "type": "object"
  },
  "name": "list_issue_tracked_times"
}
