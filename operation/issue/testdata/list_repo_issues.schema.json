{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List repo issues",
  "inputSchema": {
    "properties": {
      "labels": {
        "description": "Labels (comma-separated)",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "milestones": {
        "description": "Milestone names/IDs (comma-separated)",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "sort": {
        "description": "Server-side sort order. One of: relevance, latest, oldest, recentupdate, leastupdate, mostcomment, leastcomment, nearduedate, farduedate. Default is the API's own default (latest).",
        "type": "string"
      },
      "state": {
        "default": "open",
        "description": "State (open|closed|all)",
        "type": "string"
      },
      "type": {
        "description": "Type (issues|pulls)",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repo_issues"
}
