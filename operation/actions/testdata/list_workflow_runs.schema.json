{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List workflow runs for a repository",
  "inputSchema": {
    "properties": {
      "event": {
        "description": "Filter by event type (e.g. push, pull_request, workflow_dispatch)",
        "type": "string"
      },
      "head_sha": {
        "description": "Filter by HEAD SHA",
        "type": "string"
      },
      "limit": {
        "default": 30,
        "description": "Page size",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "run_number": {
        "description": "Filter by run number",
        "type": "number"
      },
      "status": {
        "description": "Filter by status (e.g. waiting, running, success, failure, cancelled)",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_workflow_runs"
}
