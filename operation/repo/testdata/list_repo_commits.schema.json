{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List repo commits. Returns a response envelope {commits, page, limit, count, has_next}. has_next true means a further page may exist; re-issue the call with page incremented to fetch it.",
  "inputSchema": {
    "properties": {
      "limit": {
        "default": 100,
        "description": "Page size",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "minimum": 1,
        "type": "number"
      },
      "path": {
        "description": "File/dir path",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "sha": {
        "description": "SHA/branch to start from",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "page",
      "limit"
    ],
    "type": "object"
  },
  "name": "list_repo_commits"
}
