{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "Filter notifications scoped to a single repository (page/limit). Returns a response envelope {notifications, page, limit, count, has_next}. has_next true means a further page may exist; re-issue the call with page incremented to fetch it.",
  "inputSchema": {
    "properties": {
      "all": {
        "description": "Include read notifications (default: false)",
        "type": "boolean"
      },
      "before": {
        "description": "Before time (RFC3339)",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "since": {
        "description": "After time (RFC3339)",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repo_notifications"
}
