  },
  "description": "List a repository's branch protection rules (bounded by page/limit). Returns a response envelope {branch_protections, page, limit, count, has_next}. has_next true means a further page may exist; re-issue the call with page incremented to fetch it.",
  "inputSchema": {
    "properties": {
      "limit": {
        "default": 100,
        "description": "Page size",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "page",
      "limit"
    ],
    "type": "object"
  },
  "name": "list_branch_protections"
}
