{
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List tracked time entries across all issues and PRs in a repository. Returns a response envelope {times, page, limit, count, has_next}; has_next true means a further page may exist; re-issue the call with page incremented to fetch it.",
  "inputSchema": {
    "properties": {
      "before": {
        "description": "Before time (RFC3339)",
        "type": "string"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "since": {
        "description": "After time (RFC3339)",
        "type": "string"
      },
      "user": {
        "description": "Filter results to this username",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repo_tracked_times"
}
