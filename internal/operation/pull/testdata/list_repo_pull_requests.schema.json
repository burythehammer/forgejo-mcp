{
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List repo pull requests. Returns a response envelope {pull_requests, page, limit, count, has_next}. has_next true means a further page may exist; re-issue the call with page incremented to fetch it.",
  "inputSchema": {
    "properties": {
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "milestone": {
        "description": "Milestone ID",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "sort": {
        "description": "Sort (oldest|recentupdate|leastupdate|mostcomment)",
        "type": "string"
      },
      "state": {
        "default": "open",
        "description": "State (open|closed|all)",
        "type": "string"
      },
      "verbose": {
        "description": "Return the full entity instead of the compact summary. Default false.",
        "type": "boolean"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repo_pull_requests"
}
