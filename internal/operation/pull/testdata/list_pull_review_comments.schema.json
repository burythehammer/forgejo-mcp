{
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List comments on a pull request review, one page at a time (page, limit; default 20). The response's has_next says whether more follow.",
  "inputSchema": {
    "properties": {
      "id": {
        "description": "Review ID",
        "type": "number"
      },
      "index": {
        "description": "PR index",
        "type": "number"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "index",
      "id"
    ],
    "type": "object"
  },
  "name": "list_pull_review_comments"
}
