{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "Edit a repository label (PATCH — only supplied fields change). Providing no fields is an error.",
  "inputSchema": {
    "properties": {
      "color": {
        "description": "New label color as 6-digit hex (e.g. #0088ff or 0088ff)",
        "type": "string"
      },
      "description": {
        "description": "New label description",
        "type": "string"
      },
      "exclusive": {
        "description": "Exclusive flag to set or clear (see create). Omit to leave the stored value unchanged.",
        "type": "boolean"
      },
      "id": {
        "description": "Label ID",
        "type": "number"
      },
      "name": {
        "description": "New label name",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "id"
    ],
    "type": "object"
  },
  "name": "edit_repo_label"
}
