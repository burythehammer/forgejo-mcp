    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "List attachments on an issue or pull request, one page at a time (page, limit; default 20). The response's has_next says whether more follow.",
  "inputSchema": {
    "properties": {
      "index": {
        "description": "Issue/PR index",
        "type": "number"
      },
      "limit": {
        "default": 20,
        "description": "Page size",
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "index"
    ],
    "type": "object"
  },
  "name": "list_issue_attachments"
}
