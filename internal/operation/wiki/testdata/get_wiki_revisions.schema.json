{
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "description": "Get a wiki page's revision history with page/limit pagination; returns has_next and total_count, the page's total number of revisions as reported in the response body.",
  "inputSchema": {
    "properties": {
      "limit": {
        "default": 30,
        "description": "Page size",
        "minimum": 1,
        "type": "number"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "minimum": 1,
        "type": "number"
      },
      "page_name": {
        "description": "Wiki page name",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "page_name"
    ],
    "type": "object"
  },
  "name": "get_wiki_revisions"
}
