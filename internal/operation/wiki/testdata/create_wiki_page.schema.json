  "description": "Create a wiki page. Slash-separated titles such as Parent/Child are a flat naming convention: Forgejo stores no parent-child relationship and does not create a parent page automatically. Creating an existing title overwrites it. Use the returned page_name verbatim; never derive it from title.",
  "inputSchema": {
    "properties": {
      "content": {
        "description": "Wiki page content",
        "type": "string"
      },
      "message": {
        "description": "Commit message",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "title": {
        "description": "Wiki page title",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "title",
      "content"
    ],
    "type": "object"
  },
  "name": "create_wiki_page"
}
