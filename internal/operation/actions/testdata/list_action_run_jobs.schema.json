        "type": "string"
      },
      "page": {
        "default": 1,
        "description": "Page number (1-based)",
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "run_id": {
        "description": "Run ID",
        "minimum": 1,
        "type": "number"
      }
    },
    "required": [
